      // flycast's BBA is seen as the console's is.
      // "--patch", "0x8c020580=0x000b0009", "--patch", "0x8c020584=0xe300e001",
      // Its two ways back to the BIOS menu loop on themselves instead.
      // "--patch", "0x8c014e28=0x0009affe", "--patch", "0x8c044cfc=0xaffe0009", "--patch", "0x8c044d00=0x654e0009",
      // flycast needs a set built with DREAMCAST_IP=192.168.1.130 and
      // CDDA_TICKS_X8192=580480; build it into a directory of its own and
      // name it here. Only "loaders" (DHCP, console clock) is kept.
